# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash

# Create this with @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Optional but recommended after you know your Telegram user ID via /whoami.
# Comma-separated numeric IDs. If empty, anyone who can message the bot can use it.
TELEGRAM_ALLOWED_USER_IDS=

# Local storage
HEART_RANKER_DB=data/heart_ranker.sqlite3
TELEGRAM_USER_SESSION=sessions/user
TELEGRAM_BOT_SESSION=sessions/bot

# Default index size when no message_limit is provided.
# Use /index <channel_url> 0 or /rank <channel_url> 10 after setting this to 0
# only when you intentionally want all available history.
INDEX_MESSAGE_LIMIT=5000

# When /rank or /top is used after the channel already has local data, refresh
# only the newest N messages before returning the ranking. 0 means refresh all.
RANK_REFRESH_MESSAGE_LIMIT=500
INDEX_PROGRESS_EVERY=500
INDEX_REQUEST_SLEEP_SECONDS=0.2

# Logging. LOG_FILE can be left empty to log only to stdout/systemd journal.
LOG_LEVEL=INFO
LOG_FILE=logs/tg_heart_ranker.log
